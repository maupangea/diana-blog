---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Diana`} description={post.data.description}>
  <article class="prose prose-invert prose-indigo max-w-none">
    <header class="mb-8 not-prose">
      <time class="text-xs text-gray-500 uppercase tracking-wide">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-white">{post.data.title}</h1>
      <p class="mt-3 text-gray-400 text-lg">{post.data.description}</p>
    </header>

    <div class="text-gray-300 leading-relaxed">
      <Content />
    </div>
  </article>

  <div class="mt-12 pt-6 border-t border-gray-800">
    <a href="/blog" class="text-sm text-indigo-400 hover:text-indigo-300 transition-colors">&larr; Back to Blog</a>
  </div>
</BaseLayout>
