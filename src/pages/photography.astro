---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import placeholder from '../assets/placeholder.png';
import geometryPlant from '../assets/geometry-plant.jpeg';
import iztacPopo from '../assets/iztac-popo.jpeg';
import playaDelCarmen from '../assets/playa-del-carmen.jpeg';
---

<BaseLayout title="Photography — Mauricio" description="A visual journey through Mauricio's lens.">
  <div>
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">Photography</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-10">A visual journey through my lens.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <Image src={geometryPlant} alt="Planta con patrones geométricos" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <Image src={iztacPopo} alt="Foto del Iztaccíhuatl y Popocatépetl" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <Image src={playaDelCarmen} alt="Foto en Playa del Carmen" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <Image src={placeholder} alt="Calm ocean waves at sunrise" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <Image src={placeholder} alt="Autumn leaves on a winding road" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <Image src={placeholder} alt="Snow-capped peaks under a blue sky" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
    </div>
  </div>
</BaseLayout>
