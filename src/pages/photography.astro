---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import placeholder from '../assets/placeholder.png';
import ciudad from '../assets/ciudad.png';
---

<BaseLayout title="Photography — Diana" description="A visual journey through Diana's lens.">
  <div>
    <h1 class="text-3xl font-bold tracking-tight text-white mb-2">Photography</h1>
    <p class="text-gray-400 mb-10">A visual journey through my lens.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="overflow-hidden rounded-xl border border-gray-800">
        <Image src={ciudad} alt="Ciudad en blanco y negro" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-800">
        <Image src={placeholder} alt="Misty forest path in the morning" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-800">
        <Image src={placeholder} alt="Golden hour over the city skyline" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-800">
        <Image src={placeholder} alt="Calm ocean waves at sunrise" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-800">
        <Image src={placeholder} alt="Autumn leaves on a winding road" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
      <div class="overflow-hidden rounded-xl border border-gray-800">
        <Image src={placeholder} alt="Snow-capped peaks under a blue sky" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300" />
      </div>
    </div>
  </div>
</BaseLayout>
